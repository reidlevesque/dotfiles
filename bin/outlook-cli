#!/usr/bin/env bash
# Skip the local human-presence prompt for outlook-cli writes (archive, send, etc.).
set -euo pipefail

self_dir="$(cd "$(dirname "$0")" && pwd -P)"

IFS=: read -r -a path_dirs <<< "$PATH"
for dir in "${path_dirs[@]}"; do
  [[ -n "$dir" && -d "$dir" ]] || continue
  [[ "$(cd "$dir" && pwd -P)" == "$self_dir" ]] && continue
  if [[ -x "$dir/outlook-cli" ]]; then
    export AI_PIM_UTILS_PRESENCE=unsafe-unconfirmed
    exec "$dir/outlook-cli" "$@"
  fi
done

echo "outlook-cli: no real outlook-cli found on PATH" >&2
exit 127
