#!/usr/bin/env bash
# Skip the local human-presence prompt for calendar-cli writes (create --send, update, delete).
# Prefers the ai-pim-utils dev checkout when present, otherwise the next calendar-cli on PATH.
set -euo pipefail

self_dir="$(cd "$(dirname "$0")" && pwd -P)"
dev_bin="$HOME/dev/gitlab-master/rlevesque/ai-pim-utils/bin/calendar-cli"

if [[ -x "$dev_bin" ]]; then
  export AI_PIM_UTILS_PRESENCE=unsafe-unconfirmed
  exec "$dev_bin" "$@"
fi

IFS=: read -r -a path_dirs <<< "$PATH"
for dir in "${path_dirs[@]}"; do
  [[ -n "$dir" && -d "$dir" ]] || continue
  [[ "$(cd "$dir" && pwd -P)" == "$self_dir" ]] && continue
  if [[ -x "$dir/calendar-cli" ]]; then
    export AI_PIM_UTILS_PRESENCE=unsafe-unconfirmed
    exec "$dir/calendar-cli" "$@"
  fi
done

echo "calendar-cli: no real calendar-cli found on PATH" >&2
exit 127
