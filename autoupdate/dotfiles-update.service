[Unit]
Description=Pull dotfiles and run install.sh
ConditionPathIsDirectory=%h/.dotfiles/.git

[Service]
Type=oneshot
# The user manager does not load the login shell profile.
Environment=PATH=%h/.local/bin:%h/bin:%h/.local/share/mise/shims:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:%h/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
Environment=GIT_TERMINAL_PROMPT=0
WorkingDirectory=%h/.dotfiles
ExecStart=git pull --no-rebase --ff-only
ExecStart=%h/.dotfiles/install.sh
TimeoutStartSec=1h
