[Unit]
Description=Send a Slack DM when the dotfiles update fails

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/bin:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:%h/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash %h/.dotfiles/autoupdate/notify-failure.sh
TimeoutStartSec=90s
